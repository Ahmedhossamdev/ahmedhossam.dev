<style>
  .follow-section {
    border-top: 1px solid var(--border);
    padding-block: 2.5rem;
    margin-top: 3rem;
  }

  .follow-heading {
    font-size: 1.0625rem;
    font-weight: 600;
    color: var(--heading);
    margin-bottom: 0.625rem;
  }

  .follow-text {
    font-size: 0.9375rem;
    color: var(--muted);
    line-height: 1.6;
  }

  .support-text {
    font-size: 0.875rem;
    color: var(--muted);
    margin-top: 0.5rem;
  }

  .follow-link {
    color: var(--text);
    text-decoration: underline;
    text-decoration-color: color-mix(in srgb, var(--text) 30%, transparent);
    text-underline-offset: 3px;
    transition:
      color 120ms ease,
      text-decoration-color 120ms ease;
  }

  .follow-link:hover {
    color: var(--link-hover);
    text-decoration-color: var(--link-hover);
  }
</style>
