<section class="follow-section">
  <div class="content-shell">
    <h2 class="follow-heading">Receive my updates</h2>
    <p class="follow-text">
      Follow me via
      <a href="mailto:ahmedhossamdev1@gmail.com" class="follow-link">email</a>,
      <a href="/rss.xml" class="follow-link">RSS</a>,
      <a href="https://x.com/Ahmedhossamdev" class="follow-link" target="_blank" rel="noopener noreferrer">X</a>,
      <a href="https://bsky.app/profile/ahmedhossamdev.bsky.social" class="follow-link" target="_blank" rel="noopener noreferrer">Bluesky</a>,
