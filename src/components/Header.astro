---
const currentPath = Astro.url.pathname;

function isCurrent(path: string) {
  if (path === "/") return currentPath === "/";
  return currentPath.startsWith(path);
}
---

<script>
  const toggle = document.getElementById("theme-toggle");

  function updateToggle() {
    const isDark = document.documentElement.dataset.theme !== "light";
    toggle?.setAttribute("aria-label", isDark ? "Switch to light mode" : "Switch to dark mode");
    toggle?.setAttribute("aria-pressed", String(!isDark));
  }

  updateToggle();

  toggle?.addEventListener("click", () => {
    const next = document.documentElement.dataset.theme === "light" ? "dark" : "light";
    document.documentElement.dataset.theme = next;
    localStorage.setItem("theme", next);
    updateToggle();
  });
</script>

<header class="site-header">
  <div class="page-shell">
    <nav class="header-nav" aria-label="Main navigation">
      <a href="/" class="site-name" aria-label="Ahmed Hossam — Home">
        Ahmed Hossam
      </a>
      <ul class="nav-links" role="list">
        <li>
          <a
            href="/writing"
            class="nav-link"
            aria-current={isCurrent("/writing") ? "page" : undefined}
          >
            Writing
          </a>
        </li>
        <li>
          <a
            href="/about"
            class="nav-link"
            aria-current={isCurrent("/about") ? "page" : undefined}
          >
            About
          </a>
        </li>
        <li>
          <a
            href="/now"
            class="nav-link"
            aria-current={isCurrent("/now") ? "page" : undefined}
          >
            Now
          </a>
        </li>
        <li>
          <button id="theme-toggle" class="theme-toggle" aria-label="Switch to light mode" aria-pressed="false">
            <!-- Moon: visible in dark mode -->
            <svg class="icon-moon" xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path fill-rule="evenodd" d="M9.528 1.718a.75.75 0 01.162.819A8.97 8.97 0 009 6a9 9 0 009 9 8.97 8.97 0 003.463-.69.75.75 0 01.981.98 10.503 10.503 0 01-9.694 6.46c-5.799 0-10.5-4.701-10.5-10.5 0-4.368 2.667-8.112 6.46-9.694a.75.75 0 01.818.162z" clip-rule="evenodd"/>
            </svg>
            <!-- Sun: visible in light mode -->
            <svg class="icon-sun" xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="M12 2.25a.75.75 0 01.75.75v2.25a.75.75 0 01-1.5 0V3a.75.75 0 01.75-.75zM7.5 12a4.5 4.5 0 119 0 4.5 4.5 0 01-9 0zM18.894 6.166a.75.75 0 00-1.06-1.06l-1.591 1.59a.75.75 0 101.06 1.061l1.591-1.59zM21.75 12a.75.75 0 01-.75.75h-2.25a.75.75 0 010-1.5H21a.75.75 0 01.75.75zM17.834 18.894a.75.75 0 001.06-1.06l-1.59-1.591a.75.75 0 10-1.061 1.06l1.59 1.591zM12 18a.75.75 0 01.75.75V21a.75.75 0 01-1.5 0v-2.25A.75.75 0 0112 18zM7.166 17.834a.75.75 0 00-1.06 1.06l1.59 1.591a.75.75 0 101.061-1.06l-1.591-1.591zM6 12a.75.75 0 01-.75.75H3a.75.75 0 010-1.5h2.25A.75.75 0 016 12zM6.166 5.106a.75.75 0 00-1.06 1.06l1.59 1.591a.75.75 0 101.061-1.06l-1.591-1.591z"/>
            </svg>
          </button>
        </li>
      </ul>
    </nav>
  </div>
</header>

<style>
  .site-header {
    padding-block: 1.5rem;
    border-bottom: 1px solid var(--border);
  }

  .header-nav {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
  }

  .site-name {
    font-size: 1rem;
    font-weight: 550;
    color: var(--heading);
    text-decoration: none;
    letter-spacing: -0.01em;
    flex-shrink: 0;
    transition: color 120ms ease;
  }

  .site-name:hover {
    color: var(--link-hover);
  }

  .nav-links {
    display: flex;
    align-items: center;
    gap: 1.75rem;
    list-style: none;
  }

  .theme-toggle {
    background: none;
    border: none;
    cursor: pointer;
    color: var(--muted);
    padding: 2px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: var(--radius-sm);
    transition: color 120ms ease;
    line-height: 1;
  }

  .theme-toggle:hover {
    color: var(--text);
  }

  @media (max-width: 480px) {
    .header-nav {
      flex-direction: column;
      align-items: flex-start;
      gap: 0.75rem;
    }

    .nav-links {
      gap: 1.25rem;
    }
  }
</style>
