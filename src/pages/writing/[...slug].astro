---
import ArticleLayout from "@/layouts/ArticleLayout.astro";
import { getReadingTime, getPublishedWriting, extractLinks } from "@/utils/content";

export async function getStaticPaths() {
  const posts = await getPublishedWriting();
  return posts.map((post, index) => ({
    params: { slug: post.slug },
    props: {
      post,
      prevPost: posts[index + 1] ?? null,
      nextPost: posts[index - 1] ?? null,
    },
  }));
}

const { post, prevPost, nextPost } = Astro.props;
const { Content } = await post.render();
const readingTime = getReadingTime(post.body);
const links = extractLinks(post.body);
---

<ArticleLayout
  title={post.data.title}
  description={post.data.description}
  publishedAt={post.data.publishedAt}
  updatedAt={post.data.updatedAt}
  tags={post.data.tags}
  readingTime={readingTime}
  links={links}
  canonicalUrl={new URL(`/writing/${post.slug}`, Astro.site).href}
  prevPost={prevPost ? { title: prevPost.data.title, slug: prevPost.slug } : null}
  nextPost={nextPost ? { title: nextPost.data.title, slug: nextPost.slug } : null}
>
  <Content />
</ArticleLayout>
