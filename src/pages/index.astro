---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { getPublishedNotes, getPublishedWriting, getReadingTime } from "@/utils/content";

const posts = await getPublishedWriting();
const recentNotes = (await getPublishedNotes()).slice(0, 3);
const latest = posts[0];
const latestReadingTime = latest ? getReadingTime(latest.body) : null;

const tagSet = new Set<string>();
for (const post of posts) {
  for (const tag of post.data.tags) tagSet.add(tag);
}
const topics = [...tagSet].sort((a, b) => a.localeCompare(b));

function archiveDate(date: Date): string {
  const year = date.getFullYear();
  const month = String(date.getMonth() + 1).padStart(2, "0");
  const day = String(date.getDate()).padStart(2, "0");
  return `${year}·${month}·${day}`;
}

function fullDate(date: Date): string {
  return date.toLocaleDateString("en-US", {
    month: "long",
    day: "numeric",
    year: "numeric",
  });
}

function notePreview(body: string | undefined, title?: string): string {
  const text = title ?? body ?? "Untitled note";
  const plainText = text
    .replace(/!\[[^\]]*\]\([^)]+\)/g, "")
    .replace(/\[([^\]]+)\]\([^)]+\)/g, "$1")
    .replace(/[`*_>#~-]/g, "")
    .replace(/\s+/g, " ")
    .trim();

  return plainText.length > 100 ? `${plainText.slice(0, 97).trimEnd()}…` : plainText;
}
---

<BaseLayout
  title="Ahmed Hossam"
  description="Software, open source, things I'm learning, and whatever else gets stuck in my head."
>
  <div class="content-shell writing-page">

    {latest && (
      <section class="latest-section">
        <p class="section-label">Latest</p>
        <h2 class="latest-title">
          <a href={`/writing/${latest.slug}`}>{latest.data.title}</a>
        </h2>
        <p class="latest-meta">
          {fullDate(latest.data.publishedAt)}
          {latestReadingTime && <> · {latestReadingTime}</>}
        </p>
        {latest.data.description && (
          <p class="latest-desc">
            {latest.data.description}{" "}
            <a href={`/writing/${latest.slug}`} class="keep-reading">Keep reading →</a>
          </p>
        )}
      </section>
    )}

    <hr class="section-divider" />

    {topics.length > 0 && (
      <section class="topics-section">
        <p class="section-label">Topics</p>
        <p class="topic-list">
          {topics.map((topic, i) => (
            <>
              <a
                href={`/writing/topic/${topic.toLowerCase().replace(/\s+/g, "-")}`}
                class="topic-link"
              >{topic}</a>{i < topics.length - 1 ? <span class="topic-comma">, </span> : null}
            </>
          ))}
        </p>
      </section>
    )}

    <hr class="section-divider" />

    {posts.length > 0 && (
      <section class="archive-section">
        <p class="section-label">Writing</p>
        <ul class="archive-list" role="list">
          {posts.map((post) => (
            <li class="archive-row">
              <time class="archive-date" datetime={post.data.publishedAt.toISOString()}>
                {archiveDate(post.data.publishedAt)}
              </time>
              <a href={`/writing/${post.slug}`} class="archive-title">
                {post.data.title}
              </a>
            </li>
          ))}
        </ul>
      </section>
    )}

    <hr class="section-divider" />

    <section class="recent-notes-section">
      <div class="section-heading">
        <p class="section-label">Recent notes</p>
        <a href="/notes" class="all-notes-link">All notes →</a>
      </div>
      {recentNotes.length > 0 ? (
        <ul class="recent-notes-list" role="list">
          {recentNotes.map((note) => (
            <li class="recent-note-row">
              <time class="recent-note-date" datetime={note.data.publishedAt.toISOString()}>
                {archiveDate(note.data.publishedAt)}
              </time>
              <a href={`/notes#${note.slug}`} class="recent-note-link">
                {notePreview(note.body, note.data.title)}
              </a>
            </li>
          ))}
        </ul>
      ) : (
        <p class="empty-notes">Nothing here yet.</p>
      )}
    </section>

  </div>
</BaseLayout>

<style>
  .writing-page {
    padding-block: 3rem;
  }

  .section-label {
    font-size: 0.875rem;
    color: var(--muted);
    margin-bottom: 1rem;
  }

  .latest-section {
    margin-bottom: 2.5rem;
  }

  .latest-title {
    font-size: 1.5rem;
    font-weight: 700;
    color: var(--heading);
    letter-spacing: -0.02em;
    line-height: 1.2;
    margin-bottom: 0.5rem;
  }

  .latest-title a {
    color: inherit;
    text-decoration: none;
    transition: color 120ms ease;
  }

  .latest-title a:hover {
    color: var(--link-hover);
  }

  .latest-meta {
    font-size: 0.875rem;
    color: var(--muted);
    margin-bottom: 0.625rem;
  }

  .latest-desc {
    font-size: 0.9375rem;
    color: var(--muted);
    line-height: 1.6;
  }

  .keep-reading {
    color: var(--muted);
    text-decoration: none;
    white-space: nowrap;
    transition: color 120ms ease;
  }

  .keep-reading:hover {
    color: var(--text);
  }

  .section-divider {
    border: none;
    border-top: 1px solid var(--border);
    margin-block: 2.5rem;
  }

  .topics-section {
    margin-bottom: 2.5rem;
  }

  .topic-list {
    font-size: 0.9375rem;
    line-height: 1.8;
    color: var(--muted);
  }

  .topic-link {
    color: var(--link);
    text-decoration: underline;
    text-decoration-color: color-mix(in srgb, var(--link) 40%, transparent);
    text-underline-offset: 3px;
    transition:
      color 120ms ease,
      text-decoration-color 120ms ease;
  }

  .topic-link:hover {
    color: var(--link-hover);
    text-decoration-color: var(--link-hover);
  }

  .topic-comma {
    color: var(--muted);
  }

  .archive-section {
    margin-bottom: 2rem;
  }

  .archive-list {
    list-style: none;
  }

  .archive-row {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 0.5rem;
    align-items: baseline;
    padding-block: 0.3125rem;
  }

  .archive-date {
    font-size: 0.875rem;
    color: var(--muted);
    white-space: nowrap;
    font-variant-numeric: tabular-nums;
  }

  .archive-title {
    font-size: 0.9375rem;
    color: var(--text);
    text-decoration: underline;
    text-decoration-color: color-mix(in srgb, var(--text) 30%, transparent);
    text-underline-offset: 3px;
    transition:
      color 120ms ease,
      text-decoration-color 120ms ease;
  }

  .archive-title:hover {
    color: var(--link-hover);
    text-decoration-color: var(--link-hover);
  }

  .recent-notes-section {
    margin-bottom: 2rem;
  }

  .section-heading {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
  }

  .all-notes-link {
    color: var(--muted);
    font-size: 0.8125rem;
    text-decoration: none;
  }

  .all-notes-link:hover {
    color: var(--link-hover);
  }

  .recent-notes-list {
    list-style: none;
  }

  .recent-note-row {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 0.75rem;
    align-items: baseline;
    padding-block: 0.375rem;
  }

  .recent-note-date {
    color: var(--muted);
    font-size: 0.8125rem;
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }

  .recent-note-link {
    color: var(--text);
    font-family: var(--font-reading);
    font-size: 1rem;
    font-style: italic;
    line-height: 1.5;
    text-decoration: none;
  }

  .recent-note-link:hover {
    color: var(--link-hover);
  }

  .empty-notes {
    color: var(--muted);
    font-size: 0.875rem;
  }

  @media (max-width: 480px) {
    .archive-row,
    .recent-note-row {
      grid-template-columns: 1fr;
      gap: 0;
    }

    .archive-date,
    .recent-note-date {
      display: none;
    }

    .archive-title::before {
      content: "·";
      color: var(--muted);
      margin-right: 0.4rem;
    }
  }
</style>
