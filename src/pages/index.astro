---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { getPublishedWriting } from "@/utils/content";
import { formatDateShort, getYear } from "@/utils/dates";

const posts = await getPublishedWriting();
---

<BaseLayout title="Ahmed Hossam">
  <div class="content-shell home-page">
    <section class="home-section">
      <h2 class="section-label">Writing</h2>
      {posts.length > 0 ? (
        <ul class="post-list" role="list">
          {posts.map((post) => (
            <li class="post-item">
              <time class="post-date" datetime={post.data.publishedAt.toISOString()}>
                {formatDateShort(post.data.publishedAt)}, {getYear(post.data.publishedAt)}
              </time>
              <a href={`/writing/${post.slug}`} class="post-title">
                {post.data.title}
              </a>
              {post.data.tags.length > 0 && (
                <span class="post-tags">
                  {post.data.tags.slice(0, 2).join(" · ")}
                </span>
              )}
            </li>
          ))}
        </ul>
      ) : (
        <p class="empty">Nothing published yet.</p>
      )}
      <div class="section-footer">
        <a href="/rss.xml" class="rss-link">RSS</a>
      </div>
    </section>
  </div>
</BaseLayout>

<style>
  .home-page {
    padding-top: 4rem;
    padding-bottom: 3rem;
  }

  .home-section {
    margin-bottom: 3rem;
  }

  .section-label {
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--muted);
    margin-bottom: 1.25rem;
    padding-bottom: 0.75rem;
    border-bottom: 1px solid var(--border);
  }

  .post-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.125rem;
  }

  .post-item {
    display: grid;
    grid-template-columns: 7rem 1fr auto;
    gap: 0.75rem;
    align-items: baseline;
    padding-block: 0.625rem;
    border-bottom: 1px solid color-mix(in srgb, var(--border) 50%, transparent);
  }

  .post-item:last-child {
    border-bottom: none;
  }

  .post-date {
    font-size: 0.8125rem;
    color: var(--muted);
    white-space: nowrap;
    flex-shrink: 0;
  }

  .post-title {
    font-size: 0.9375rem;
    color: var(--text);
    text-decoration: none;
    transition: color 120ms ease;
    font-weight: 450;
  }

  .post-title:hover {
    color: var(--link-hover);
  }

  .post-tags {
    font-size: 0.75rem;
    color: var(--muted);
    white-space: nowrap;
  }

  .empty {
    font-size: 0.9375rem;
    color: var(--muted);
  }

  .section-footer {
    display: flex;
    justify-content: flex-end;
    margin-top: 1.25rem;
  }

  .rss-link {
    font-size: 0.8125rem;
    color: var(--muted);
    text-decoration: none;
    transition: color 120ms ease;
  }

  .rss-link:hover {
    color: var(--text);
  }

  @media (max-width: 560px) {
    .post-item {
      grid-template-columns: 1fr;
      gap: 0.25rem;
    }

    .post-tags {
      display: none;
    }
  }
</style>
